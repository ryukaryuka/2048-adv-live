      },
      "accent_duration": 1.5,
      "accent_delay": 0.06,
      "music": "comic"
    },
    {
      "source_line": 2,
      "speaker": "hinata",
      "text": "さすが王都っすねえ。",
      "cast": [
        "slime",
        "hinata"
      ],
      "cut": "S20_C02",
      "music": "comic"
    },
    {
      "source_line": 3,
      "speaker": "kraken",
      "text": "……ずいぶん注目されてるわねえ。",
      "cast": [
        "kraken"
      ],
      "cut": "S20_C03",
      "music": "comic",
      "accents": {
        "kraken": "sweat"
      },
      "accent_duration": 1.6,
      "accent_delay": 0.06
    },
    {
      "source_line": 4,
      "speaker": "child",
      "text": "……さわっていい？",
      "cast": [
        "slime"
      ],
      "cut": "S20_C04",
      "music": "comic",
      "accents": {
        "child": "question"
      },
      "accent_duration": 1.5,
      "accent_delay": 0.06
    },
    {
      "source_line": 5,
      "speaker": "slime",
      "text": "いいよー。",
      "cast": [
        "slime"
      ],
      "cut": "S20_C04",
      "music": "comic"
    },
    {
      "source_line": 6,
      "speaker": "child",
      "text": "やわらかい！",
      "cast": [
        "slime"
      ],
      "cut": "S20_C04",
      "music": "comic",
      "accents": {
        "child": "joy_rays"
      },
      "accent_duration": 1.5,
      "accent_delay": 0.06
    },
    {
      "source_line": 7,
      "speaker": "slime",
      "text": "やわらかいー。",
      "cast": [
        "slime"
      ],
      "cut": "S20_C04",
      "music": "comic",
      "accents": {
        "slime": "joy_rays"
      },
      "accent_duration": 1.5,
      "accent_delay": 0.06
    },
    {
      "source_line": 8,
      "speaker": "hinata",
      "text": "……王都の人たち、魔物を見ても普通に接してくれるんすね。",
      "cast": [
        "hinata",
        "flare"
      ],
      "cut": "S20_C05",
      "music": "comic",
      "accents": {
        "hinata": "sweat"
      },
      "accent_duration": 1.5,
      "accent_delay": 0.06
    },
    {
      "source_line": 9,
      "speaker": "flare",
      "text": "ええ。最初から敵意があるわけではないんです。",
      "cast": [
        "hinata",
        "flare"
      ],
      "cut": "S20_C05",
      "music": "comic"
    },
    {
      "source_line": 10,
      "speaker": "arachne",
      "text": "それなのに、鐘が鳴ると態度が変わるのですね。",
      "cast": [
        "arachne"
      ],
      "cut": "S20_C06",
      "music": "comic"
    },
    {
      "source_line": 11,
      "speaker": "hinata",
      "text": "心当たりって、あの鐘のことっすか？",
      "cast": [
        "hinata",
        "flare"
      ],
      "cut": "S20_C07",
      "music": "comic",
      "accents": {
        "hinata": "question"
      },
      "accent_duration": 1.5,
      "accent_delay": 0.06
    },
    {
      "source_line": 12,
      "speaker": "flare",
      "text": "正確には、鐘を管理している教会です。",
      "cast": [
        "hinata",
        "flare"
      ],
      "cut": "S20_C07",
      "music": "comic"
    },
    {
      "source_line": 13,
      "speaker": "flare",
      "text": "あれが王都の大聖堂です。国内の鐘は、教会が管理しています。",
      "cast": [],
      "cut": "S20_C08",
      "music": "comic"
    },
    {
      "source_line": 14,
      "speaker": "hinata",
      "text": "じゃあ、行ってみるっすか。",
      "cast": [
        "hinata",
        "flare"
      ],
      "cut": "S20_C09",
      "music": "comic"
    },
    {
      "source_line": 15,
      "speaker": "flare",
      "text": "ええ。",
      "cast": [
        "hinata",
        "flare"
      ],
      "cut": "S20_C09",
      "music": "comic"
    },
    {
      "source_line": 16,
      "speaker": "hinata",
      "text": "でっかい教会っすねえ。",
      "cast": [
        "kraken",
        "hinata"
      ],
      "cut": "S20_C10",
      "music": "sacred",
      "accents": {
        "hinata": "joy_rays"
      },
      "accent_duration": 1.5,
      "accent_delay": 0.06
    },
    {
      "source_line": 17,
      "speaker": "kraken",
      "text": "引っ越し先には向かなそうねえ。",
      "cast": [
        "kraken",
        "hinata"
      ],
      "cut": "S20_C10",
      "music": "sacred"
    },
    {
      "source_line": 18,
      "speaker": "hinata",
      "text": "候補に入れてないっすよ。",
      "cast": [
        "kraken",
        "hinata"
      ],
      "cut": "S20_C10",
      "music": "sacred",
      "accents": {
        "hinata": "grumble"
      },
      "accent_duration": 1.6,
      "accent_delay": 0.06,
      "sfx": "res://audio/adv/lab/stupid3.wav",
      "sfx_delay": 0.1
    },
    {
      "source_line": 19,
      "speaker": "priests",
      "text": "聖冠の加護を、この地の隅々まで。",
      "cast": [],
      "cut": "S20_C11",
      "music": "sacred"
    },
    {
      "source_line": 20,
      "speaker": "flare",
      "text": "……鐘を鳴らす前の祈りです。もうすぐ、鐘が鳴ります。",
      "cast": [
        "flare"
      ],
      "cut": "S20_C12",
      "music": "sacred"
    },
    {
      "source_line": 21,
      "speaker": "priest",
      "text": "人は地上に。",
      "cast": [],
      "cut": "S20_C13",
      "music": "sacred"
    },
    {
      "source_line": 22,
      "speaker": "priests",
      "text": "人は地上に。",
      "cast": [],
      "cut": "S20_C13",
      "music": "sacred"
    },
    {
      "source_line": 23,
      "speaker": "priest",
      "text": "魔はダンジョンに。",
      "cast": [],
      "cut": "S20_C13",
      "music": "sacred"
    },
    {
      "source_line": 24,
      "speaker": "priests",
      "text": "魔はダンジョンに。",
      "cast": [],
      "cut": "S20_C13",
      "music": "sacred"
    },
    {
      "source_line": 0,
