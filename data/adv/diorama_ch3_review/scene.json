  "lines": [
    {
      "source_line": -411,
      "speaker": "hinata",
      "text": "お、町が見えてきたっすよ！",
      "cast": [
        "hinata"
      ],
      "cut": "C00",
      "music": "comic"
    },
    {
      "source_line": -412,
      "speaker": "kraken",
      "text": "地上の町って、こんなに大きいのねえ。",
      "cast": [
        "kraken",
        "hinata"
      ],
      "cut": "C00",
      "music": "comic"
    },
    {
      "source_line": 1,
      "speaker": "soldier",
      "text": "止まれ！　これ以上、町へ近づくな！",
      "cast": [
        "soldier"
      ],
      "cut": "C01",
      "music": "comic",
      "accents": {
        "soldier": "exclaim"
      },
      "accent_duration": 1.5,
      "accent_delay": 0.06
    },
    {
      "source_line": 2,
      "speaker": "hinata",
      "text": "だから、引っ越しなんすって。",
      "cast": [
        "hinata"
      ],
      "cut": "C02",
      "music": "comic"
    },
    {
      "source_line": 3,
      "speaker": "soldier",
      "text": "……本当に、町を襲うつもりはないのか？",
      "cast": [
        "hinata",
        "soldier"
      ],
      "cut": "C03",
      "music": "comic",
      "accents": {
        "soldier": "ellipsis"
      },
      "accent_duration": 1.5,
      "accent_delay": 0.06
    },
    {
      "source_line": 4,
      "speaker": "hinata",
      "text": "ないっすよ。住める場所を探してるだけっす。",
      "cast": [
        "hinata",
        "soldier"
      ],
      "cut": "C03",
      "music": "comic"
    },
    {
      "source_line": 5,
      "speaker": "soldier",
      "text": "魔物が……地上に住む場所を？",
      "cast": [
        "hinata",
        "soldier"
      ],
      "cut": "C03",
      "accents": {
        "soldier": "question"
      },
      "accent_duration": 1.5,
      "accent_delay": 0.06,
      "music": "comic"
    },
    {
      "source_line": 6,
      "speaker": "hinata",
      "text": "そうっす。空いてる家とか土地とか、知らないです？",
      "cast": [
        "hinata",
        "soldier"
      ],
      "cut": "C03",
      "music": "comic"
    },
    {
      "source_line": 7,
      "speaker": "soldier",
      "text": "……。",
      "cast": [],
      "cut": "C04",
      "music": "comic"
    },
    {
      "source_line": 8,
      "speaker": "soldier",
      "text": "町の外れなら、使われていない建物が――",
      "cast": [
        "soldier"
      ],
      "cut": "C04",
      "music": "comic"
    },
    {
      "source_line": 0,
      "speaker": "bell",
      "text": "ゴォン――。",
      "cast": [],
      "cut": "E01",
      "music": "mystery"
    },
    {
      "source_line": 9,
      "speaker": "hinata",
      "text": "？",
      "cast": [
        "hinata"
      ],
      "cut": "C05",
      "music": "mystery",
      "accents": {
        "hinata": "sweat"
      },
      "accent_duration": 1.5,
      "accent_delay": 0.06
    },
    {
      "source_line": 10,
      "speaker": "kraken",
      "text": "……。",
      "cast": [
        "kraken"
      ],
      "cut": "C06",
      "music": "mystery"
    },
    {
      "source_line": 11,
      "speaker": "soldier",
      "text": "……魔物は、ダンジョンにいるものだ。",
      "cast": [
        "soldier"
      ],
      "cut": "C07",
      "music": "mystery",
      "accents": {
        "soldier": "grumble"
      },
      "accent_duration": 1.5,
      "accent_delay": 0.06
    },
    {
      "source_line": 12,
      "speaker": "hinata",
      "text": "……え？",
      "cast": [
        "hinata",
        "soldier"
      ],
      "cut": "C08",
      "accents": {
        "hinata": "question"
      },
      "accent_duration": 1.5,
      "accent_delay": 0.06,
      "music": "mystery"
    },
    {
      "source_line": 13,
      "speaker": "soldier",
      "text": "地上へ出てきてはならない。",
      "cast": [
        "hinata",
        "soldier"
      ],
      "cut": "C08",
      "music": "mystery"
    },
    {
      "source_line": -301,
      "speaker": "kraken",
      "text": "……そうねえ。戻りましょうか。",
      "recovery_insert": "bell_recovery_20260930",
      "cut": "S10_RECOVERY",
      "cast": [
        "kraken",
        "hinata"
      ],
      "music": "mystery"
    },
    {
      "source_line": -302,
      "speaker": "hinata",
      "text": "ちょっと、まだ引っ越し先、見つかってないっすよ。",
      "recovery_insert": "bell_recovery_20260930",
      "cut": "S10_RECOVERY",
      "cast": [
        "kraken",
        "hinata"
      ],
      "music": "mystery"
    },
    {
      "source_line": -303,
      "speaker": "kraken",
      "text": "……あら。そうだったわねえ。",
      "recovery_insert": "bell_recovery_20260930",
      "cut": "S10_RECOVERY",
      "cast": [
        "kraken",
        "hinata"
      ],
      "music": "mystery"
    },
    {
      "source_line": 15,
      "speaker": "hinata",
      "text": "もう一回話してみるっす。……あの、さっきの空いてる建物の話なんすけど。",
      "cast": [
        "hinata",
        "soldier"
      ],
      "cut": "C10",
      "music": "mystery"
    },
    {
      "source_line": 16,
      "speaker": "soldier",
      "text": "魔物は、ダンジョンにいるものだ。",
      "cast": [
        "hinata",
        "soldier"
      ],
      "cut": "C10",
      "music": "mystery"
    },
    {
      "source_line": 17,
      "speaker": "hinata",
      "text": "……やっぱ変っすね。",
      "cast": [
        "hinata"
      ],
      "cut": "C12",
      "music": "mystery"
    },
    {
      "source_line": 18,
      "speaker": "hinata",
      "text": "さっきまで普通に話せてたのに。",
      "cast": [
        "hinata"
      ],
      "cut": "C12",
      "music": "mystery"
    },
    {
      "source_line": 19,
      "speaker": "arachne",
      "text": "鐘が鳴ってから、ね。",
      "cast": [
        "arachne",
        "hinata"
      ],
      "cut": "C13",
      "music": "mystery"
    },
    {
      "source_line": 20,
      "speaker": "soldier",
      "text": "引き返せ！　これ以上進むなら、敵とみなす！",
      "cast": [
        "hinata",
        "soldier"
      ],
      "cut": "C14",
      "music": "mystery",
      "accents": {
        "soldier": "exclaim"
      },
      "accent_duration": 1.5,
      "accent_delay": 0.06
    },
    {
      "source_line": 21,
      "speaker": "hinata",
      "text": "理由も分かんないまま帰れって言われても困るっすよ。",
      "cast": [
        "hinata",
        "soldier"
      ],
      "cut": "C14",
      "music": "mystery"
    },
    {
      "source_line": 22,
      "speaker": "soldier",
      "text": "この先にはフレア殿下がいる！　近づかせるものか！",
      "cast": [
        "hinata",
        "soldier"
      ],
      "cut": "C14",
      "music": "mystery"
    },
    {
      "source_line": 23,
      "speaker": "hinata",
      "text": "フレア殿下……王女様っすか？",
      "cast": [
        "hinata",
        "soldier"
      ],
      "cut": "C14",
      "accents": {
        "hinata": "question"
      },
      "accent_duration": 1.5,
      "accent_delay": 0.06,
      "music": "mystery"
    },
    {
      "source_line": 24,
      "speaker": "soldier",
      "text": "そうだ！",
      "cast": [
        "hinata",
        "soldier"
      ],
      "cut": "C14",
      "music": "mystery"
    },
    {
      "source_line": 25,
      "speaker": "hinata",
      "text": "じゃあ、その人なら話を聞いてくれるかもしれないっすね。",
      "cast": [
        "hinata",
        "soldier"
      ],
      "cut": "C14",
      "music": "mystery"
    },
    {
      "source_line": 26,
      "speaker": "soldier",
      "text": "話を聞いていなかったのか！？",
      "cast": [
        "hinata",
        "soldier"
      ],
      "cut": "C14",
      "accents": {
        "soldier": "exclaim"
      },
      "accent_duration": 1.5,
      "accent_delay": 0.06,
      "sfx": "res://audio/adv/lab/decision22.wav",
      "sfx_delay": 0.1,
      "music": "mystery"
    },
    {
      "source_line": 27,
      "speaker": "hinata",
      "text": "聞いてたから、その人に聞きに行くんすよ。",
      "cast": [
        "hinata",
        "soldier"
      ],
      "cut": "C14",
      "music": "mystery"
    },
    {
      "source_line": 28,
      "speaker": "maou",
      "text": "うむ。",
      "cast": [
        "maou"
      ],
      "cut": "C15",
      "music": "mystery"
    },
    {
      "source_line": 29,
      "speaker": "soldier",
      "text": "これ以上進むなら――！　この街道の先で、殿下が視察をなさっているのだぞ！",
      "cast": [
        "soldier"
      ],
      "cut": "C16",
      "music": "mystery"
    },
    {
      "source_line": 30,
      "speaker": "kraken",
      "text": "あら。この道をまっすぐ行けばいいのね。",
      "cast": [
        "kraken"
      ],
      "cut": "C17",
      "music": "mystery"
    },
    {
      "source_line": 31,
      "speaker": "soldier",
      "text": "そういう意味ではない！",
      "cast": [
        "soldier"
      ],
      "cut": "C18",
      "accents": {
        "soldier": "exclaim"
      },
      "accent_duration": 1.5,
      "accent_delay": 0.06,
      "sfx": "res://audio/adv/lab/decision22.wav",
      "sfx_delay": 0.1,
      "music": "mystery"
    },
    {
      "source_line": 32,
      "speaker": "hinata",
      "text": "親切な道案内っすね！",
      "cast": [
        "hinata"
      ],
      "cut": "C19",
      "accents": {
        "hinata": "joy_rays"
      },
      "accent_duration": 1.5,
      "accent_delay": 0.06,
      "music": "mystery"
    },
    {
      "source_line": 33,
      "speaker": "hinata",
      "text": "魔王様、行きましょう！",
      "cast": [
        "hinata"
      ],
      "cut": "C19",
      "music": "mystery"
    },
    {
      "source_line": 34,
      "speaker": "maou",
      "text": "うむ。",
      "cast": [
        "hinata",
        "maou"
      ],
      "cut": "C20",
      "music": "mystery"
    }
